{
  "name": "autodiag-agent",
  "version": "4.2.0",
  "description": "AutoDiag Pro - Agente J2534 x86 - koffi + ELM327 fallback",
  "main": "agent-lite.js",
  "scripts": {
    "start": "node agent-lite.js",
    "build": "pkg agent-lite.js --targets node18-win-x86 --output dist/AutoDiagAgent.exe --no-bytecode --public-packages \"*\" --public"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "serialport": "^12.0.0",
    "koffi": "^2.8.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "targets": [
      "node18-win-x86"
    ],
    "assets": [
      "*.dll"
    ],
    "scripts": [
      "agent-lite.js"
    ]
  }
}